<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dermatologist_book_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/gradients">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/containerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Your existing layout content here -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Book Consultation"
                    android:textAlignment="textStart"
                    android:textColor="@color/dark_lavender"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Get consultation from the best dermatologists!"
                    android:textAlignment="textStart"
                    android:textColor="@color/light_grey"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Search Dermatologist"
                    android:textAlignment="textStart"
                    android:textColor="@color/lavender"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Search by Name"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dermatologist_book_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/light_grey_border"
                    android:drawablePadding="8dp"
                    android:hint="Name"
                    android:padding="10dp"
                    android:textColor="@color/black" />
                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Search by City"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dermatologist_book_city"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/light_grey_border"
                    android:drawablePadding="8dp"
                    android:hint="City"
                    android:padding="8dp"
                    android:textColor="@color/black" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text= "Search"
                    android:id="@+id/search"
                    android:textSize="18sp"
                    android:layout_marginTop="20dp"
                    app:cornerRadius = "20dp" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text= "List all Dermatologists"
                    android:id="@+id/listAll"
                    android:textSize="18sp"
                    android:layout_marginTop="20dp"
                    app:cornerRadius = "20dp" />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
