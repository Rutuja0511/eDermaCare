<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradients"
    android:gravity="center">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width='match_parent'
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/light_grey_border"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="223dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create Account"
            android:textAlignment="textStart"
            android:textColor="@color/lavender"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Sign Up to Get Started."
            android:textAlignment="textStart"
            android:textColor="@color/light_grey"
            android:textSize="19sp" />

        <EditText
            android:id="@+id/dermatologist_signup_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Name"
            android:padding="10dp"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/dermatologist_signup_email"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Email"
            android:padding="8dp"
            android:textColor="@color/black" />

        <Spinner
            android:id="@+id/spinner_gender_dermatologist"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/light_grey_border"
            android:paddingStart="8dp"
            android:paddingEnd="24dp"
            android:drawableEnd="@drawable/baseline_calendar_month_24"
            android:textColor="@color/black"
            />

        <EditText
            android:id="@+id/dermatologist_signup_RegNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Registration ID Number"
            android:inputType="phone"
            android:padding="8dp"
            android:textColor="@color/black" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dermatologist_signup_RegYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"

            app:hintEnabled="false">

            <EditText
                android:id="@+id/dermatologist_signup_year"
                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:background="@drawable/light_grey_border"
                android:clickable="false"
                android:drawableEnd="@drawable/baseline_calendar_month_24"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:hint="Registration Year"
                android:inputType="text"
                android:padding="8dp"
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>


        <Spinner
            android:id="@+id/spinner_state_medical_council"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/light_grey_border"
            android:padding="8dp"
            android:spinnerMode="dropdown" />


        <!--        <Button-->
        <!--            android:id="@+id/dermatologist_license_upload"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="60dp"-->
        <!--            android:layout_marginTop="24dp"-->
        <!--            android:text="Upload License"-->
        <!--            android:textSize="18sp"-->
        <!--            app:cornerRadius="15dp" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dermatologistFilename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text=""
                android:textColor="@color/light_grey"
                android:textSize="19sp" />

            <Button
                android:id="@+id/dermatologist_upload_button"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:minWidth="100dp"
                android:text="Upload License"
                android:textSize="16sp"
                app:cornerRadius="16dp" />

        </LinearLayout>


        <Button
            android:id="@+id/dermatologist_next_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="Next"
            android:textSize="22sp"
            app:cornerRadius="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/signupRedirectTextDermatologist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:paddingLeft="8dp"
                android:paddingTop="8dp"
                android:paddingRight="0dp"
                android:paddingBottom="8dp"
                android:text="Already an user?"
                android:textColor="@color/light_grey"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/loginredirectDermatologist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|start"
                android:layout_marginTop="8dp"
                android:paddingLeft="6dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:text="Login"
                android:textColor="@color/lavender"
                android:textSize="19sp" />

        </LinearLayout>

    </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
