<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFF">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            app:title="eDermaCare"
            app:titleTextColor="@color/white" />

        <!-- Heading TextView for Acne -->
        <TextView
            android:id="@+id/acneHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What are Nail Infections?"
            android:textAppearance="?android:textAppearanceLarge"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center"
            android:textColor="#0097A7"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <!-- Description TextView for Acne -->
        <TextView
            android:id="@+id/acneDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nail infections, caused by fungi, bacteria, viruses, or yeast, result in symptoms such as thickened, discolored nails, pain, swelling, and pus. Fungal infections, like onychomycosis, are common and lead to brittle, crumbly nails. Bacterial infections can cause redness and swelling around the nails. Viral infections, such as warts, present as raised bumps. Yeast infections are less common but can occur, especially in those with weakened immune systems or frequent exposure to moisture. Treatment varies depending on the type of infection and may include antifungal medications, antibiotics, or medical intervention."
            android:textAppearance="?android:textAppearanceMedium"
            android:gravity="start"
            android:textSize="20sp"
            android:textColor="#0097A7"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"/>


        <Button
            android:id="@+id/gobackButton"
            android:layout_width="200dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:layout_marginBottom="40dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/roud2"
            android:text="Back"
            android:layout_gravity="center_horizontal"
            android:textColor="@android:color/white"
            android:textSize="18sp"/>


        <!-- Repeat the above structure for other diseases -->

    </LinearLayout>

</ScrollView>
