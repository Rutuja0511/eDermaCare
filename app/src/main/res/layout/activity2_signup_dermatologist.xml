<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".detectFragment1"
    android:paddingVertical="10dp"
    android:paddingHorizontal="18dp"
    android:background="@drawable/gradients">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        app:cardCornerRadius="15dp"
        android:layout_centerInParent="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins"
                android:text="Details"
                android:textAlignment="textStart"
                android:textColor="@color/darkgray"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/dermatologist_mobileNo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/light_grey_border"
                android:drawablePadding="8dp"
                android:hint="Mobile Number"
                android:padding="10dp"
                android:textColor="@color/black" />

            <EditText
                android:id="@+id/dermatologist_experience"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/light_grey_border"
                android:drawablePadding="8dp"
                android:hint="Experience (in years)"
                android:padding="8dp"
                android:textColor="@color/black" />

<!--            <EditText-->
<!--                android:id="@+id/dermatologist_state"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_marginTop="24dp"-->
<!--                android:background="@drawable/light_grey_border"-->
<!--                android:drawablePadding="8dp"-->
<!--                android:hint="State"-->
<!--                android:padding="8dp"-->
<!--                android:textColor="@color/black" />-->

<!--            <EditText-->
<!--                android:id="@+id/dermatologist_district"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_marginTop="24dp"-->
<!--                android:background="@drawable/light_grey_border"-->
<!--                android:drawablePadding="8dp"-->
<!--                android:hint="District"-->
<!--                android:padding="8dp"-->
<!--                android:textColor="@color/black" />-->

<!--            <EditText-->
<!--                android:id="@+id/dermatologist_city"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_marginTop="24dp"-->
<!--                android:background="@drawable/light_grey_border"-->
<!--                android:drawablePadding="8dp"-->
<!--                android:hint="City"-->
<!--                android:padding="8dp"-->
<!--                android:textColor="@color/black" />-->


            <Spinner
                android:id="@+id/spinnerState"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/light_grey_border"
                android:padding="8dp"
                android:spinnerMode="dropdown" />

            <!-- District Spinner -->
            <Spinner
                android:id="@+id/spinnerDistrict"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/light_grey_border"
                android:padding="8dp"
                android:spinnerMode="dropdown" />

            <!-- City Spinner -->
            <Spinner
                android:id="@+id/spinnerCity"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/light_grey_border"
                android:padding="8dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/dermatologist_signup_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/light_grey_border"
                android:drawablePadding="8dp"
                android:hint="Password"
                android:inputType="textPassword"
                android:padding="8dp"
                android:textColor="@color/black" />

            <Button
                android:id="@+id/dermatologist_signup_button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="24dp"
                android:text="Sign Up"
                android:textSize="18sp"
                app:cornerRadius="15dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
