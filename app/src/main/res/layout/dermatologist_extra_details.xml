<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dermatologist_book_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:title="Clinic Details"
        android:layout_marginBottom="30dp"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:id="@+id/containerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Your existing layout content here -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Please enter following details to proceed"
                    android:textAlignment="textStart"
                    android:textColor="@color/dark_lavender"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Clinic Address 1"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dermatologist_clinic_addr_1"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/light_grey_border"
                    android:drawablePadding="8dp"
                    android:hint="Name"
                    android:padding="10dp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Clinic Address 2"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dermatologist_clinic_addr_2"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/light_grey_border"
                    android:drawablePadding="8dp"
                    android:hint="Name"
                    android:padding="10dp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Clinic Address 3"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/dermatologist_clinic_addr_3"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/light_grey_border"
                    android:drawablePadding="8dp"
                    android:hint="Name"
                    android:padding="10dp"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Enter clinic time"
                    android:textAlignment="textStart"
                    android:textColor="@color/darkgray"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:text="Start Time:"
                        android:textColor="@color/darkgray"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/start_time"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/light_grey_border"
                        android:drawablePadding="8dp"
                        android:hint="HH:MM"
                        android:inputType="time"
                        android:padding="10dp"
                        android:textColor="@color/black" />

                    <Button
                        android:id="@+id/start_time_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:onClick="selectStartTime"
                        android:text="Select Start Time"
                        android:layout_marginStart="8dp"/>


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End Time:    "
                        android:textColor="@color/darkgray"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/end_time"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/light_grey_border"
                        android:drawablePadding="8dp"
                        android:hint="HH:MM"
                        android:inputType="time"
                        android:padding="10dp"
                        android:textColor="@color/black" />


                    <Button
                        android:id="@+id/end_time_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="selectStartTime"
                        android:text="Select End Time"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>


                <Button
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="20dp"
                    android:text="Save"
                    android:textSize="18sp"
                    app:cornerRadius="20dp" />


            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>



</androidx.constraintlayout.widget.ConstraintLayout>
