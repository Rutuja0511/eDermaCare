<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">


    <LinearLayout
        android:layout_width="430dp"
        android:layout_height="763dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/light_grey_border"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="223dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Create Account"
            android:textAlignment="textStart"
            android:textColor="@color/lavender"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Sign Up to Get Started."
            android:textAlignment="textStart"
            android:textColor="@color/light_grey"
            android:textSize="19sp" />

        <EditText
            android:id="@+id/patient_signup_name"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Name"
            android:padding="10dp"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/patient_signup_email"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Email"
            android:padding="8dp"
            android:textColor="@color/black" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/patient_signup_dob_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"

            app:hintEnabled="false">

            <EditText
                android:id="@+id/patient_signup_dob"
                android:layout_height="50dp"
                android:layout_width="match_parent"

                android:background="@drawable/light_grey_border"
                android:drawableEnd="@drawable/baseline_calendar_month_24"
                android:drawablePadding="8dp"
                android:hint="Date of Birth"
                android:inputType="text"
                android:padding="8dp"
                android:textColor="@color/black"
                android:clickable="false"
                android:focusable="false" />

        </com.google.android.material.textfield.TextInputLayout>





        <EditText
            android:id="@+id/patient_signup_mobile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:padding="8dp"
            android:textColor="@color/black" />

        <EditText
            android:id="@+id/patient_signup_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/light_grey_border"
            android:drawablePadding="8dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="8dp"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/patient_signup_button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="Sign Up"
            android:textSize="18sp"
            app:cornerRadius="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/signupRedirectText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|start"
                android:layout_marginTop="10dp"
                android:paddingLeft="8dp"
                android:paddingTop="8dp"
                android:paddingRight="0dp"
                android:paddingBottom="8dp"
                android:text="Already an user?"
                android:textColor="@color/light_grey"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/loginredirect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|start"
                android:layout_marginTop="10dp"
                android:paddingLeft="2dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp"
                android:text="Login"
                android:textColor="@color/lavender"
                android:textSize="19sp" />

    </LinearLayout>

    </LinearLayout>

</LinearLayout>
